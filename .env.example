# Public Firebase Web SDK configuration (safe to expose in the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Set only after the Firebase createStripeCheckoutSession function is deployed.
VITE_STRIPE_CHECKOUT_ENDPOINT=
VITE_STRIPE_PORTAL_ENDPOINT=

# Menu-image analysis and AI Chef are served by same-origin Vercel functions by default.
# Keep provider credentials and the Firebase Admin credential server-side.
VITE_MENU_ANALYSIS_ENDPOINT=/api/analyze-menu
KITCHEN_DIARY_CHEF_CHAT_ENDPOINT=/api/chef-chat
# Native Google Play subscriptions use this endpoint after purchase. Keep the
# Play service-account JSON server-side and enable billing only after the Play
# products and package have been created.
KITCHEN_DIARY_PLAY_VERIFY_ENDPOINT=/api/google-play/verify-purchase
KITCHEN_DIARY_GOOGLE_PLAY_PRODUCT_IDS=kitchendiary_premium_monthly,kitchendiary_premium_yearly
KITCHEN_DIARY_ANDROID_PACKAGE=com.kitchendiary.app
KITCHEN_DIARY_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
KITCHEN_DIARY_WEB_ORIGIN=https://kitchen-diary-three.vercel.app
# Optional: only a service account from this same Firebase project is accepted.
KITCHEN_DIARY_FIREBASE_PROJECT_ID=kitchen-diary-19971117
# Required by server routes that write Firestore entitlements; must belong to
# kitchen-diary-19971117. Keep it encrypted in Vercel only.
FIREBASE_SERVICE_ACCOUNT_JSON=
KITCHEN_DIARY_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=https://kitchen-diary-three.vercel.app
# Use these instead when KITCHEN_DIARY_AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
