# Non-secret Firebase Functions parameters. Set real values with `firebase functions:config:set`
# only if you choose legacy config; the provided implementation uses Firebase parameter prompts.
# Configure these at deploy time or in the Firebase console/CLI as documented.
ALLOWED_ORIGIN=https://your-web-app.example
